# Application / PostgreSQL
# Keep the app private behind the existing nginx reverse proxy.
APP_BIND_IP=127.0.0.1
# Choose a free localhost port on the VPS; preflight checks it before deployment.
APP_PORT=3100
POSTGRES_DB=lts_control
POSTGRES_USER=lts
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://lts:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/lts_control

# Authentication
# Generate a random value with at least 32 characters, e.g. openssl rand -hex 32
# Temporary IPv4/HTTP development: false. Switch to true when HTTPS is enabled.
AUTH_COOKIE_SECURE=false
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
# Optional dedicated secret for temporary public document links; falls back to AUTH_SECRET when empty.
DOCUMENT_SHARE_SECRET=
# Optional canonical external URL, e.g. https://control.ltslogistik.de. Falls back to the current request origin.
PUBLIC_APP_URL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# MEGA S4 document storage
MEGA_S4_ENDPOINT=
MEGA_S4_REGION=
MEGA_S4_BUCKET=
MEGA_S4_PREFIX=fahrzeuge
MEGA_S4_DRIVER_PREFIX=fahrer
MEGA_S4_FORCE_PATH_STYLE=false
MEGA_S4_ACCESS_KEY=
MEGA_S4_SECRET_KEY=

# Samsara live fleet data
SAMSARA_API_BASE_URL=https://api.eu.samsara.com
SAMSARA_API_TOKEN=
SAMSARA_ONLINE_THRESHOLD_MINUTES=15
SAMSARA_SYNC_INTERVAL_SECONDS=300
SAMSARA_SYNC_TIMEOUT_SECONDS=240

# Existing vacation portal (kept as separate application)
VACATION_PORTAL_URL=

# Existing DDD Analyzer / violation source
# The analyzer can POST normalized batches to /api/ddd/batches.
DDD_ANALYZER_URL=
DDD_ANALYZER_API_TOKEN=

# Chatwoot / WhatsApp agent workspace
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=

# n8n API + webhooks
N8N_API_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE_URL=

# Meta WhatsApp Cloud API
META_GRAPH_API_VERSION=v23.0
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
