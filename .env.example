# Application / PostgreSQL
APP_PORT=3000
POSTGRES_DB=lts_control
POSTGRES_USER=lts
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://lts:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@postgres:5432/lts_control

# Authentication
# Generate a random value with at least 32 characters, e.g. openssl rand -hex 32
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# MEGA S4 document storage
MEGA_S4_ENDPOINT=
MEGA_S4_REGION=
MEGA_S4_BUCKET=
MEGA_S4_PREFIX=fahrzeuge
MEGA_S4_FORCE_PATH_STYLE=false
MEGA_S4_ACCESS_KEY=
MEGA_S4_SECRET_KEY=

# Samsara live fleet data
SAMSARA_API_BASE_URL=https://api.eu.samsara.com
SAMSARA_API_TOKEN=
SAMSARA_ONLINE_THRESHOLD_MINUTES=15

# Existing vacation portal (kept as separate application)
VACATION_PORTAL_URL=

# Communication / automation integrations (later modules)
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
N8N_WEBHOOK_BASE_URL=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
