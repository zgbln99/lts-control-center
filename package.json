{
  "name": "lts-control-center",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "start": "npm --workspace apps/web run start",
    "db:generate": "npm --workspace packages/db run generate",
    "db:push": "npm --workspace packages/db run push",
    "db:studio": "npm --workspace packages/db run studio",
    "import:kfz": "node scripts/import-kfz-xlsx.mjs",
    "import:kfz:db": "node scripts/import-kfz-to-db.mjs",
    "sync:mega-s4": "node scripts/sync-mega-s4.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.883.0",
    "xlsx": "0.18.5"
  }
}
