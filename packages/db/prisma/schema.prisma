generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleCategory {
  TRUCK
  VAN
  TRAILER
  SEMITRAILER
  OTHER
}

enum DeadlineType {
  TUV
  SP
  TACHO
  UVV
  SERVICE
  INSURANCE
  LEASING
  OTHER
}

enum DocumentSource {
  GOOGLE_DRIVE_IMPORT
  MEGA_S4
  MANUAL
  SAMSARA
  SYSTEM
}

enum VehicleLifecycle {
  ACTIVE
  SOLD
  RETURNED
  SCRAPPED
  ARCHIVED
}

enum UserRole {
  ADMIN
  FUHRPARK
  PERSONAL
  DISPOSITION
  READ_ONLY
}

model Vehicle {
  id                    String           @id @default(uuid())
  sourcePosition        Int?
  plate                 String           @unique
  plateOriginal         String?
  plateAliases          String[]         @default([])
  firstRegistration     DateTime?
  vin                   String?          @unique
  insuranceNumber       String?
  taxNumber             String?
  manufacturer          String?
  model                 String?
  displayName           String?
  taxMonthAmount        Decimal?         @db.Decimal(12,2)
  taxQuarterAmount      Decimal?         @db.Decimal(12,2)
  taxSumAmount          Decimal?         @db.Decimal(12,2)
  grossVehicleWeightKg  Int?
  documentsNotes        String?
  financingEnd          DateTime?
  financingEndRaw       String?
  registeredAt          DateTime?
  monthlyRate           Decimal?         @db.Decimal(12,2)
  rateRaw               String?
  inventoryNumber       String?
  notes                 String?
  lifecycleNote         String?
  sourceRaw             Json?
  category              VehicleCategory  @default(OTHER)
  lifecycle             VehicleLifecycle @default(ACTIVE)
  cameraInstalled       Boolean?
  wrapped               Boolean?
  wrapType              String?
  samsaraId             String?          @unique
  storagePrefix         String?
  soldAt                DateTime?
  soldTo                String?
  soldPrice             Decimal?         @db.Decimal(12,2)
  soldMileageKm         Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deadlines             VehicleDeadline[]
  documents             VehicleDocument[]
  syncMappings          StorageFolderMapping[]
  hookLoadPeriods       VehicleHookLoadPeriod[]
  telemetry             VehicleTelemetry?
}

model VehicleTelemetry {
  vehicleId      String   @id
  samsaraId      String?
  online         Boolean?
  odometerKm     Int?
  latitude       Float?
  longitude      Float?
  address        String?
  locationLabel  String?
  geofenceName   String?
  lastSeenAt     DateTime?
  raw            Json?
  syncedAt       DateTime @default(now()) @updatedAt
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([lastSeenAt])
  @@index([geofenceName])
}

model VehicleDeadline {
  id          String       @id @default(uuid())
  vehicleId   String
  type        DeadlineType
  customType  String?
  dueDate     DateTime
  completedAt DateTime?
  notes       String?
  optional    Boolean      @default(false)
  documentId  String?
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([vehicleId, dueDate])
  @@index([type, dueDate])
}

model VehicleDocument {
  id           String         @id @default(uuid())
  vehicleId    String
  type         String?
  filename     String
  storageKey   String         @unique
  mimeType     String?
  sizeBytes    BigInt?
  etag         String?
  checksum     String?
  documentDate DateTime?
  expiresAt    DateTime?
  source       DocumentSource @default(MEGA_S4)
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([vehicleId])
  @@index([expiresAt])
}

model StorageFolderMapping {
  id              String   @id @default(uuid())
  vehicleId       String
  originalFolder  String   @unique
  storagePrefix   String
  normalizedPlate String?
  confidence      Float?
  confirmed       Boolean  @default(false)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@index([vehicleId])
}

model VehicleHookLoadPeriod {
  id        String   @id @default(uuid())
  vehicleId String?
  plateText String
  startsAt  DateTime
  endsAt    DateTime?
  sourceRaw Json?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([vehicleId, startsAt])
  @@index([plateText])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(READ_ONLY)
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([active, role])
}
