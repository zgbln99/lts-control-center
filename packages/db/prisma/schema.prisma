generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleCategory {
  TRUCK
  VAN
  TRAILER
  SEMITRAILER
  OTHER
}

enum DeadlineType {
  TUV
  SP
  TACHO
  UVV
  SERVICE
  INSURANCE
  LEASING
  OTHER
}

enum DocumentSource {
  GOOGLE_DRIVE_IMPORT
  MEGA_S4
  MANUAL
  SAMSARA
  SYSTEM
}

enum VehicleLifecycle {
  ACTIVE
  SOLD
  RETURNED
  SCRAPPED
  ARCHIVED
}

enum UserRole {
  ADMIN
  FUHRPARK
  PERSONAL
  DISPOSITION
  READ_ONLY
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  LEFT
}

enum WorkshopStatus {
  OPEN
  PLANNED
  IN_PROGRESS
  WAITING_PARTS
  DONE
  CANCELLED
}

enum WorkshopPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TemplateChannel {
  WHATSAPP
  EMAIL
  LETTER
  SYSTEM
}

enum AutomationProvider {
  N8N
  SYSTEM
}

enum CostCategory {
  FUEL
  MAUT
  LEASING
  INSURANCE
  TAX
  SERVICE
  REPAIR
  TIRES
  CLEANING
  OTHER
}

enum IntegrationKey {
  SAMSARA
  MEGA_S4
  CHATWOOT
  N8N
  META
  VACATION_PORTAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  LOGIN
  LOGOUT
  UPLOAD
  SYNC
}

model Vehicle {
  id                    String           @id @default(uuid())
  sourcePosition        Int?
  plate                 String           @unique
  plateOriginal         String?
  plateAliases          String[]         @default([])
  firstRegistration     DateTime?
  vin                   String?          @unique
  insuranceNumber       String?
  taxNumber             String?
  manufacturer          String?
  model                 String?
  displayName           String?
  taxMonthAmount        Decimal?         @db.Decimal(12,2)
  taxQuarterAmount      Decimal?         @db.Decimal(12,2)
  taxSumAmount          Decimal?         @db.Decimal(12,2)
  grossVehicleWeightKg  Int?
  documentsNotes        String?
  financingEnd          DateTime?
  financingEndRaw       String?
  registeredAt          DateTime?
  monthlyRate           Decimal?         @db.Decimal(12,2)
  rateRaw               String?
  inventoryNumber       String?
  notes                 String?
  lifecycleNote         String?
  sourceRaw             Json?
  category              VehicleCategory  @default(OTHER)
  lifecycle             VehicleLifecycle @default(ACTIVE)
  cameraInstalled       Boolean?
  wrapped               Boolean?
  wrapType              String?
  samsaraId             String?          @unique
  storagePrefix         String?
  soldAt                DateTime?
  soldTo                String?
  soldPrice             Decimal?         @db.Decimal(12,2)
  soldMileageKm         Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deadlines             VehicleDeadline[]
  documents             VehicleDocument[]
  syncMappings          StorageFolderMapping[]
  hookLoadPeriods       VehicleHookLoadPeriod[]
  telemetry             VehicleTelemetry?
  workshopOrders        WorkshopOrder[]
  costs                 CostEntry[]
}

model VehicleTelemetry {
  vehicleId      String   @id
  samsaraId      String?
  online         Boolean?
  odometerKm     Int?
  latitude       Float?
  longitude      Float?
  address        String?
  locationLabel  String?
  geofenceName   String?
  lastSeenAt     DateTime?
  raw            Json?
  syncedAt       DateTime @default(now()) @updatedAt
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([lastSeenAt])
  @@index([geofenceName])
}

model VehicleDeadline {
  id          String       @id @default(uuid())
  vehicleId   String
  type        DeadlineType
  customType  String?
  dueDate     DateTime
  completedAt DateTime?
  notes       String?
  optional    Boolean      @default(false)
  documentId  String?
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([vehicleId, dueDate])
  @@index([type, dueDate])
}

model VehicleDocument {
  id           String         @id @default(uuid())
  vehicleId    String
  type         String?
  filename     String
  storageKey   String         @unique
  mimeType     String?
  sizeBytes    BigInt?
  etag         String?
  checksum     String?
  documentDate DateTime?
  expiresAt    DateTime?
  source       DocumentSource @default(MEGA_S4)
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  @@index([vehicleId])
  @@index([expiresAt])
}

model StorageFolderMapping {
  id              String   @id @default(uuid())
  vehicleId       String
  originalFolder  String   @unique
  storagePrefix   String
  normalizedPlate String?
  confidence      Float?
  confirmed       Boolean  @default(false)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@index([vehicleId])
}

model VehicleHookLoadPeriod {
  id        String   @id @default(uuid())
  vehicleId String?
  plateText String
  startsAt  DateTime
  endsAt    DateTime?
  sourceRaw Json?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([vehicleId, startsAt])
  @@index([plateText])
}

model Driver {
  id                  String       @id @default(uuid())
  personnelNumber     String?      @unique
  firstName           String
  lastName            String
  phone               String?
  email               String?
  language            String       @default("de")
  status              DriverStatus @default(ACTIVE)
  employmentStart     DateTime?
  employmentEnd       DateTime?
  licenseNumber       String?
  licenseClasses      String[]     @default([])
  licenseExpiresAt    DateTime?
  driverCardNumber    String?      @unique
  driverCardExpiresAt DateTime?
  code95ExpiresAt     DateTime?
  medicalExpiresAt    DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  documents           DriverDocument[]
  costs               CostEntry[]
  @@index([status, lastName])
  @@index([licenseExpiresAt])
  @@index([driverCardExpiresAt])
}

model DriverDocument {
  id         String         @id @default(uuid())
  driverId   String
  type       String?
  filename   String
  storageKey String         @unique
  mimeType   String?
  sizeBytes  BigInt?
  expiresAt  DateTime?
  source     DocumentSource @default(MANUAL)
  driver     Driver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  @@index([driverId])
  @@index([expiresAt])
}

model WorkshopOrder {
  id            String           @id @default(uuid())
  vehicleId     String
  title         String
  description   String?
  status        WorkshopStatus   @default(OPEN)
  priority      WorkshopPriority @default(NORMAL)
  workshop      String?
  plannedAt     DateTime?
  dueAt         DateTime?
  completedAt   DateTime?
  cost          Decimal?         @db.Decimal(12,2)
  mileageKm     Int?
  invoiceNumber String?
  notes         String?
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  @@index([status, priority])
  @@index([vehicleId, dueAt])
}

model MessageTemplate {
  id               String          @id @default(uuid())
  name             String
  channel          TemplateChannel @default(WHATSAPP)
  language         String          @default("de")
  category         String?
  subject          String?
  body             String
  metaTemplateName String?
  variables        Json?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  @@index([channel, active])
}

model DocumentTemplate {
  id              String   @id @default(uuid())
  name            String
  category        String?
  language        String   @default("de")
  content         String
  filenamePattern String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([category, active])
}

model AutomationDefinition {
  id          String             @id @default(uuid())
  name        String
  description String?
  provider    AutomationProvider @default(N8N)
  externalId  String?
  triggerType String?
  schedule    String?
  active      Boolean            @default(false)
  config      Json?
  lastRunAt   DateTime?
  lastStatus  String?
  lastMessage String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@index([provider, active])
}

model CostEntry {
  id            String       @id @default(uuid())
  vehicleId     String?
  driverId      String?
  date          DateTime
  category      CostCategory
  amount        Decimal      @db.Decimal(14,2)
  currency      String       @default("EUR")
  vendor        String?
  invoiceNumber String?
  description   String?
  source        String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver        Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@index([date, category])
  @@index([vehicleId, date])
}

model IntegrationState {
  key         IntegrationKey @id
  enabled     Boolean        @default(false)
  lastSyncAt  DateTime?
  lastStatus  String?
  lastMessage String?
  counters    Json?
  configPublic Json?
  updatedAt   DateTime       @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(READ_ONLY)
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
  @@index([active, role])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  details   Json?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
}
